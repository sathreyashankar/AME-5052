   "source": [
    "from sklearn.feature_selection import SelectKBest, chi2\n",
    "from sklearn.datasets import load_iris"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "92e825d1",
   "metadata": {},
   "outputs": [],
   "source": [
    "iris = load_iris()\n",
    "X, y = iris.data, iris.target"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "35993c02",
   "metadata": {},
   "source": [
    "##### Select k=3 Best Features"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "f88450db",
   "metadata": {},
   "outputs": [],
   "source": [
    "X_select = SelectKBest(chi2, k=3).fit_transform(X, y)\n",
    "# X_select"
   ]
